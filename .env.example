# ============================================================
# Federated Analytics Platform — Environment Configuration
# Copy this to .env and fill in your values
# ============================================================

# ----- LLM Configuration (provider-agnostic) -----
# EVERY model setting is a provider-prefixed string: "<provider>:<model_id>".
# The prefix ALONE decides the endpoint + which API key is used — there is no
# hidden base_url/key default, so switching providers is config-only (and can
# also be done live from the UI: Settings page → /api/llm-settings).
#
# Prefixes: openai: | anthropic: | google_genai: (alias gemini:) | ollama:
#           | openai_compat: (any self-hosted OpenAI-compatible endpoint)
#
# Set the key(s) for the provider(s) you use. Only these live in .env — the UI
# never stores keys. To switch everything to OpenAI: set OPENAI_API_KEY and
# change the *_MODEL values below to openai:... (e.g. openai:gpt-4o).
GOOGLE_API_KEY=
OPENAI_API_KEY=
ANTHROPIC_API_KEY=

# deepagents model strings. Top-level agents use LLM_MODEL; the cheaper *_MODEL
# settings carry the high-volume calls (a dashboard brief fans out into a dozen+
# calls, so the split keeps you inside per-minute rate limits).
LLM_MODEL=google_genai:gemini-flash-latest
SCHEMA_ANALYST_MODEL=google_genai:gemini-flash-lite-latest
SQL_GENERATOR_MODEL=google_genai:gemini-flash-latest

# Custom single-shot path (fast plan, dashboard/report SQL, repair, embeddings).
# Also provider-prefixed now. Embeddings MAY use a different provider than
# reasoning (Anthropic has no embeddings API — pair claude reasoning with
# openai:text-embedding-3-small or google_genai:gemini-embedding-001).
FAST_PATH_MODEL=google_genai:gemini-flash-lite-latest
DASHBOARD_WIDGET_SQL_MODEL=google_genai:gemini-flash-latest
EMBEDDING_MODEL=google_genai:gemini-embedding-001

# Base URL + key for the openai_compat: / ollama: prefixes ONLY (a self-hosted
# gateway or local runtime). Leave blank for cloud providers.
LLM_BASE_URL=
LLM_API_KEY=

# ----- AI Engine: fast path + rate limits -----
# Fast path: one cheap single-shot LLM call before the full deepagents pipeline
# for questions the pre-loaded schema context can already answer.
FAST_PATH_ENABLED=true
FAST_PATH_CONFIDENCE_THRESHOLD=0.55

# Per-tier rate limits (requests per minute; 0 = unlimited). A token-bucket
# limiter per tier, shared across BOTH LLM paths, so load is managed by config.
# Tiers sharing one provider key should sum under that provider's real quota.
#   frontier = LLM_MODEL, SQL_GENERATOR_MODEL, DASHBOARD_WIDGET_SQL_MODEL
#   fast     = FAST_PATH_MODEL, SCHEMA_ANALYST_MODEL
#   embed    = EMBEDDING_MODEL
LLM_FRONTIER_RPM=0
LLM_FAST_RPM=0
LLM_EMBED_RPM=0

# Retry/timeout applied to every LLM call (reactive 429 backoff, complements
# the proactive RPM limiter above).
LLM_MAX_RETRIES=5
LLM_TIMEOUT_SECONDS=60

# Caps concurrent /api/plan pipelines so request bursts don't blow through
# the provider's rate limits all at once.
AI_MAX_CONCURRENT_PLANS=4
AI_QUEUE_TIMEOUT_SECONDS=45

# TTL (seconds) for Trino/postgres-meta lookups used by agent tools.
SCHEMA_TOOL_CACHE_TTL_SECONDS=60

# ----- Feature Flags -----
# Set to false to disable AI path entirely (SQL-only mode)
AI_ENABLED=true

# ----- Auth (POC stub) -----
# Simple bearer token for POC — replace with real OIDC in production
API_AUTH_TOKEN=poc-demo-token-2024

# ----- Service Ports -----
CORE_API_PORT=8081
AI_ENGINE_PORT=8082
QUERY_SERVICE_PORT=8083

# ----- PostgreSQL Metadata DB -----
POSTGRES_META_HOST=postgres-meta
POSTGRES_META_PORT=5432
POSTGRES_META_DB=analytics_meta
POSTGRES_META_USER=meta_user
POSTGRES_META_PASSWORD=meta_pass_2024

# ----- PostgreSQL Source DB (user-managed) -----
POSTGRES_SOURCE_HOST=postgres-source
POSTGRES_SOURCE_PORT=5432
POSTGRES_SOURCE_DB=source_db
POSTGRES_SOURCE_USER=source_user
POSTGRES_SOURCE_PASSWORD=source_pass_2024

# ----- MongoDB Source DB (user-managed) -----
MONGO_SOURCE_HOST=mongo-source
MONGO_SOURCE_PORT=27017

# ----- Elasticsearch Source DB (user-managed) -----
ELASTICSEARCH_HOST=elasticsearch
ELASTICSEARCH_PORT=9200

# ----- Trino -----
TRINO_HOST=trino
TRINO_PORT=8080

# ----- Frontend -----
# Points to Core API
VITE_API_BASE_URL=http://localhost:8081
VITE_API_TOKEN=poc-demo-token-2024
