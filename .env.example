# ============================================================
# Federated Analytics Platform — Environment Configuration
# Copy this to .env and fill in your values
# ============================================================

# ----- LLM Configuration -----
# Standard LLM model config for deepagents orchestrator
LLM_MODEL=openai:gpt-4o

# OpenAI API Key
OPENAI_API_KEY=sk-...

# Anthropic API Key
ANTHROPIC_API_KEY=sk-ant-...

# ----- AI Engine: fast path + rate-limit resilience -----
# Fast path: try one cheap single-shot LLM call before the full deepagents
# pipeline, for questions the pre-loaded schema context can already answer.
FAST_PATH_ENABLED=true
# gpt-4o measured ~1s faster than gpt-4o-mini on this workload (~2s vs ~3s)
FAST_PATH_MODEL=gpt-4o
FAST_PATH_CONFIDENCE_THRESHOLD=0.55

# Retry/timeout applied to every LLM call (fast path + full pipeline) to
# absorb OpenAI 429s instead of failing the request outright.
LLM_MAX_RETRIES=5
LLM_TIMEOUT_SECONDS=60

# Caps concurrent /api/plan pipelines so request bursts don't blow through
# OpenAI's rate limits all at once.
AI_MAX_CONCURRENT_PLANS=4
AI_QUEUE_TIMEOUT_SECONDS=45

# TTL (seconds) for Trino/postgres-meta lookups used by agent tools.
SCHEMA_TOOL_CACHE_TTL_SECONDS=60

# Cheap model for the schema-analyst subagent (tool-calling, not reasoning-heavy).
SCHEMA_ANALYST_MODEL=openai:gpt-4o-mini

# ----- Feature Flags -----
# Set to false to disable AI path entirely (SQL-only mode)
AI_ENABLED=true

# ----- Auth (POC stub) -----
# Simple bearer token for POC — replace with real OIDC in production
API_AUTH_TOKEN=poc-demo-token-2024

# ----- Service Ports -----
CORE_API_PORT=8081
AI_ENGINE_PORT=8082
QUERY_SERVICE_PORT=8083

# ----- PostgreSQL Metadata DB -----
POSTGRES_META_HOST=postgres-meta
POSTGRES_META_PORT=5432
POSTGRES_META_DB=analytics_meta
POSTGRES_META_USER=meta_user
POSTGRES_META_PASSWORD=meta_pass_2024

# ----- PostgreSQL Source DB (user-managed) -----
POSTGRES_SOURCE_HOST=postgres-source
POSTGRES_SOURCE_PORT=5432
POSTGRES_SOURCE_DB=source_db
POSTGRES_SOURCE_USER=source_user
POSTGRES_SOURCE_PASSWORD=source_pass_2024

# ----- MongoDB Source DB (user-managed) -----
MONGO_SOURCE_HOST=mongo-source
MONGO_SOURCE_PORT=27017

# ----- Elasticsearch Source DB (user-managed) -----
ELASTICSEARCH_HOST=elasticsearch
ELASTICSEARCH_PORT=9200

# ----- Trino -----
TRINO_HOST=trino
TRINO_PORT=8080

# ----- Frontend -----
# Points to Core API
VITE_API_BASE_URL=http://localhost:8081
VITE_API_TOKEN=poc-demo-token-2024
