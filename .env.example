# ============================================================
# Federated Analytics Platform — Environment Configuration
# Copy this to .env and fill in your values
# ============================================================

# ----- LLM Configuration (provider-agnostic) -----
# Default provider: Google Gemini free tier (no credit card).
#   1. Get a free key at https://aistudio.google.com/apikey
#   2. Paste it into GOOGLE_API_KEY. That's the only value you must set.
# To use another provider, change the *_MODEL prefixes + keys/base_url below —
# no code changes. Prefixes: google_genai: | openai: | anthropic: | ollama:
GOOGLE_API_KEY=

# deepagents model strings. The top-level agents use LLM_MODEL; the cheaper
# *_MODEL settings below carry the high-volume calls (a dashboard brief fans out
# into a dozen+ calls, so the split keeps you inside the free-tier rate limits).
LLM_MODEL=google_genai:gemini-flash-latest

# Custom OpenAI-compatible providers (fast path, widget SQL, repair, embeddings).
# LLM_API_KEY falls back to GOOGLE_API_KEY in code — leave blank for Gemini.
LLM_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai/
LLM_API_KEY=
EMBEDDING_MODEL=gemini-embedding-001

# Other providers (optional — only if you switch the *_MODEL prefixes to them):
OPENAI_API_KEY=
ANTHROPIC_API_KEY=

# ----- AI Engine: fast path + rate-limit resilience -----
# Fast path: try one cheap single-shot LLM call before the full deepagents
# pipeline, for questions the pre-loaded schema context can already answer.
# Also used for widget SQL repair and the batched per-dashboard widget-SQL call.
FAST_PATH_ENABLED=true
# Cheap tier — high-volume, latency-sensitive single-shot call. Plain model id
# (no provider prefix), sent via the OpenAI-compatible custom provider.
FAST_PATH_MODEL=gemini-flash-lite-latest
FAST_PATH_CONFIDENCE_THRESHOLD=0.55

# Retry/timeout applied to every LLM call (fast path + full pipeline) to
# absorb 429s instead of failing the request outright.
LLM_MAX_RETRIES=5
LLM_TIMEOUT_SECONDS=60

# Caps concurrent /api/plan pipelines so request bursts don't blow through
# the provider's rate limits all at once.
AI_MAX_CONCURRENT_PLANS=4
AI_QUEUE_TIMEOUT_SECONDS=45

# TTL (seconds) for Trino/postgres-meta lookups used by agent tools.
SCHEMA_TOOL_CACHE_TTL_SECONDS=60

# Cheap tier for the schema-analyst subagent (tool-calling, not reasoning-heavy).
SCHEMA_ANALYST_MODEL=google_genai:gemini-flash-lite-latest

# sql-generator subagent (query planner's /api/plan full path) and the batched
# per-dashboard widget-SQL call/repair. Kept on the frontier tier, not the cheap
# one — this is the step that maps a Trino CROSS JOIN UNNEST alias list onto a
# nested Elasticsearch row type, where the cheap tier produced invalid SQL on
# deeply nested array fields (agency/transactions/vehicleCondition).
SQL_GENERATOR_MODEL=google_genai:gemini-flash-latest
DASHBOARD_WIDGET_SQL_MODEL=gemini-flash-latest

# ----- Feature Flags -----
# Set to false to disable AI path entirely (SQL-only mode)
AI_ENABLED=true

# ----- Auth (POC stub) -----
# Simple bearer token for POC — replace with real OIDC in production
API_AUTH_TOKEN=poc-demo-token-2024

# ----- Service Ports -----
CORE_API_PORT=8081
AI_ENGINE_PORT=8082
QUERY_SERVICE_PORT=8083

# ----- PostgreSQL Metadata DB -----
POSTGRES_META_HOST=postgres-meta
POSTGRES_META_PORT=5432
POSTGRES_META_DB=analytics_meta
POSTGRES_META_USER=meta_user
POSTGRES_META_PASSWORD=meta_pass_2024

# ----- PostgreSQL Source DB (user-managed) -----
POSTGRES_SOURCE_HOST=postgres-source
POSTGRES_SOURCE_PORT=5432
POSTGRES_SOURCE_DB=source_db
POSTGRES_SOURCE_USER=source_user
POSTGRES_SOURCE_PASSWORD=source_pass_2024

# ----- MongoDB Source DB (user-managed) -----
MONGO_SOURCE_HOST=mongo-source
MONGO_SOURCE_PORT=27017

# ----- Elasticsearch Source DB (user-managed) -----
ELASTICSEARCH_HOST=elasticsearch
ELASTICSEARCH_PORT=9200

# ----- Trino -----
TRINO_HOST=trino
TRINO_PORT=8080

# ----- Frontend -----
# Points to Core API
VITE_API_BASE_URL=http://localhost:8081
VITE_API_TOKEN=poc-demo-token-2024
